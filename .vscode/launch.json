{
  "version": "0.2.0",
  "configurations": [
    {
      "runtimeArgs": ["--test", "--test-concurrency=1", "--test-reporter=spec", "test/*.test.js", "test/tests.js"],
      "internalConsoleOptions": "openOnSessionStart",
      "name": "All JavaScript tests",
      "request": "launch",
      "skipFiles": [
        "<node_internals>/**"
      ],
      "type": "pwa-node"
    },
    {
      "runtimeArgs": ["--test", "${file}"],
      "internalConsoleOptions": "openOnSessionStart",
      "name": "Test current file",
      "request": "launch",
      "skipFiles": [
        "<node_internals>/**"
      ],
      "type": "pwa-node"
    }
  ]
}
