{
  "name": "cda-schematron-validator",
  "version": "2.0.0-preview.2",
  "description": "Self-hosted CDA validation API and UI with pinned HL7 profiles, detailed findings, and a compatible legacy Schematron API.",
  "main": "validator.js",
  "scripts": {
    "test": "node --test --test-concurrency=1 --test-reporter=spec test/*.test.js test/tests.js",
    "assets": "python3 scripts/prepare-assets.py",
    "service:build": "npm run assets && mvn -B -f service/pom.xml package",
    "service:start": "java -Xmx1g -jar service/target/cda-validator-service.jar",
    "service:test": "npm run assets && mvn -B -f service/pom.xml verify",
    "benchmark": "python3 scripts/benchmark.py"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/priyaranjan-tokachichu/cda-schematron-validator.git"
  },
  "author": "Eric Wadkins",
  "contributors": [
    {
      "name": "Eric Wadkins",
      "url": "http://www.ericwadkins.com/"
    },
    {
      "name": "Priyaranjan (Raj) Tokachichu",
      "email": "priyaranjan@priyaranjan.com",
      "url": "https://github.com/priyaranjan-tokachichu"
    }
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/priyaranjan-tokachichu/cda-schematron-validator/issues"
  },
  "homepage": "https://github.com/priyaranjan-tokachichu/cda-schematron-validator#readme",
  "dependencies": {
    "@xmldom/xmldom": "0.8.15",
    "xpath": "0.0.36"
  },
  "directories": {
    "test": "test"
  },
  "keywords": [
    "C-CDA",
    "HL7",
    "Schematron",
    "CCD",
    "XML"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "bin": {
    "cda-validate": "bin/cda-validate.js"
  },
  "files": [
    "validator.js",
    "validateSync.js",
    "validateAsync.js",
    "lib/",
    "bin/",
    "LICENSE.md",
    "README.md",
    "validator.d.ts",
    "docs/"
  ],
  "types": "validator.d.ts"
}
